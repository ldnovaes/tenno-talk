# Copy to deploy/shared-vps/vps.env (git-ignored) and fill in.
TENNO_VPS_HOST=root@203.0.113.10
TENNO_VPS_PORT=22
TENNO_DOMAIN=tenno.example.com
# Optional: blank reuses the Let's Encrypt account already on the server.
TENNO_CERT_EMAIL=
# Backend port on the VPS (127.0.0.1 only); must be free there.
TENNO_PORT=8090
# Sites already on the VPS: their answers are compared before/after any nginx change.
TENNO_NEIGHBOR_HOSTS="example.com www.example.com"
# Infisical machine identity of the tenno-talk project (Universal Auth, Viewer). provision and
# deploy write it to /etc/tenno-talk/tenno.env on the VPS. The project id has a default (lib.sh).
TENNO_INFISICAL_CLIENT_ID=
TENNO_INFISICAL_CLIENT_SECRET=
# TENNO_INFISICAL_PROJECT_ID=12c1b503-6d69-4fbe-a9a7-3601d35e2a7b
# Optional Web Push keys; generate once with node scripts/generate_vapid.mjs. Keep this file mode 600.
TENNO_VAPID_PUBLIC_KEY=
TENNO_VAPID_PRIVATE_KEY=
# TENNO_VAPID_SUBJECT=https://tenno.example.com
