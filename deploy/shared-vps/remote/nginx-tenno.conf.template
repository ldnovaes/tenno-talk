# TENNO TALK on a VPS shared with other sites (nginx already in front of them).
# Managed by tenno-talk/deploy/shared-vps (./tenno vps provision). Do not edit on the server.
#
# Rules that keep the neighbours safe:
# - exact server_name: wins over any wildcard (*.eldialabs.com) on the same ports;
# - "listen 443 ssl;" with no http2/default_server/backlog: those options belong to the whole
#   :443 socket and would change every other site on it;
# - every name here (map variable, snippet) is prefixed with "tenno".

map $http_upgrade $tenno_connection_upgrade {
    default upgrade;
    ''      close;
}

# Per-IP limits at the edge (PLAN.md §38). Generous on purpose: carrier-grade NAT puts many phones
# behind one IP. The backend keeps its own per-user limits (RateLimitRules).
limit_req_zone $binary_remote_addr zone=tenno_api:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=tenno_auth:10m rate=1r/s;
limit_conn_zone $binary_remote_addr zone=tenno_conn:10m;
limit_conn_zone $binary_remote_addr zone=tenno_ws:10m;

server {
    listen 80;
    server_name __DOMAIN__;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot-webroot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name __DOMAIN__;

    ssl_certificate /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    access_log /var/log/nginx/tenno-talk.access.log;
    error_log /var/log/nginx/tenno-talk.error.log;

    root /var/www/tenno-talk/current;
    server_tokens off;
    # JSON bodies are small; only the media upload takes files (100 MB, PLAN.md §29).
    client_max_body_size 1m;
    limit_conn tenno_conn 50;
    limit_req_status 429;
    limit_conn_status 429;

    include /etc/nginx/snippets/tenno-talk-headers.conf;

    # Dotfiles (/.env, /.git/...) never exist here: answer 404 instead of the SPA page.
    location ~ /\. {
        return 404;
    }

    # The backend listens on 127.0.0.1 only. X-Forwarded-For is REPLACED (not appended): the
    # per-IP rate limits must never trust a value sent by the client (PLAN.md §31).
    location /api/ {
        limit_req zone=tenno_api burst=120 nodelay;
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_read_timeout 120s;
    }

    # Sign-in, sign-up and password: one per second per IP (bursts of 10), before Argon2 runs.
    location ~ ^/api/auth/(signin|signup|password)$ {
        limit_req zone=tenno_auth burst=10 nodelay;
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
    }

    # Uploads are buffered by nginx (default) before reaching the backend: a slow client holds an
    # nginx connection, never one of the backend's threads.
    location = /api/media {
        limit_req zone=tenno_api burst=120 nodelay;
        client_max_body_size 100m;
        client_body_timeout 60s;
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_read_timeout 600s;
    }

    location ~ ^/(oauth2|login/oauth2)/ {
        limit_req zone=tenno_auth burst=10 nodelay;
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
    }

    location = /ws {
        limit_conn tenno_conn 50;
        limit_conn tenno_ws 20;
        limit_req zone=tenno_auth burst=20 nodelay;
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $tenno_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        # The client pings every 25s (PLAN.md §26).
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location = /actuator/health {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_set_header Host $host;
    }

    # Hashed build files never change.
    location /assets/ {
        include /etc/nginx/snippets/tenno-talk-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # SPA: every route is index.html, never cached (a new deploy must load at once).
    location / {
        include /etc/nginx/snippets/tenno-talk-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
