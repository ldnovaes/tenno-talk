# Copy to deploy/.env (never commit it).
DOMAIN=tenno.example.com
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# OAuth apps (optional: leave a provider blank and its button is not shown). Redirect URIs to register:
#   https://<DOMAIN>/login/oauth2/code/google
#   https://<DOMAIN>/login/oauth2/code/facebook
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Translation APIs (PLAN.md §28.1). OpenAI is the primary provider, Anthropic the fallback;
# a provider without a key is skipped. Models are optional.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# OPENAI_TRANSLATION_MODEL=gpt-4.1-mini
# ANTHROPIC_TRANSLATION_MODEL=claude-haiku-4-5

# Technical ceiling for one upload (there is no product limit).
MAX_UPLOAD_SIZE=500MB

# Web Push: generate once with node scripts/generate_vapid.mjs. Keep the private key secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
